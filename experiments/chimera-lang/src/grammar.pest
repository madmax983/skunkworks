dna = { SOI ~ helix ~ EOI }
helix = { strand+ }
strand = { "[" ~ gene* ~ "]" }
gene = { identifier ~ "(" ~ nucleotides ~ ")" }
nucleotides = { (number | string | identifier | junction)* }
junction = { junction_type ~ "(" ~ nucleotides ~ ")" }
junction_type = { "any" | "all" }
identifier = @{ "metabolism" | ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ ASCII_DIGIT+ }
string = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
