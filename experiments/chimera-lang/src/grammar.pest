dna = { SOI ~ helix ~ EOI }
helix = { strand+ }
strand = { "[" ~ gene* ~ "]" }
gene = { identifier ~ "(" ~ nucleotides ~ ")" }
nucleotides = { (number | string | identifier | junction | block)* }
junction = { junction_type ~ "(" ~ nucleotides ~ ")" }
junction_type = { "any" | "all" }
block = { "{" ~ gene* ~ "}" }
identifier = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ ASCII_DIGIT+ }
string = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
