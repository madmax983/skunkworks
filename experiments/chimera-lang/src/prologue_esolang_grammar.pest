WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ ("#" ~ (!"\n" ~ ANY)*) }

program = { SOI ~ section* ~ EOI }
section = { git_associates_block | git_block | gray_scott_block | locus_block | neuro_block | platter_block | forth_block | raku_block | orca_block | elektra_block | prolog_block | genetics_block | lisp_block | brainfuck_block | tui_block | tui_mod_block | mosaic_block | piet_block | chaos_block | regex_block | acoustic_block | befunge_block | reactor_block | quipu_block | origami_block | esolang_block | flocking_block | market_block | poincare_block | weave_block | fluid_block | madness_block | prologue_esolang_block | miller_block | hyper_block | physics_block | ferrous_block | tardis_block | pachinko_block | automaton_block }

tui_mod_block = { "tui_mod" ~ "{" ~ instruction* ~ "}" }
git_associates_block = { "git_associates" ~ "{" ~ instruction* ~ "}" }
git_block = { "git" ~ "{" ~ instruction* ~ "}" }
forth_block = { "forth" ~ "{" ~ instruction* ~ "}" }
raku_block = { "raku" ~ "{" ~ hyper_instruction* ~ "}" }
orca_block = { "orca" ~ "{" ~ orca_instruction* ~ "}" }
elektra_block = { "elektra" ~ "{" ~ elektra_instruction* ~ "}" }
prolog_block = { "prolog" ~ "{" ~ prolog_instruction* ~ "}" }
genetics_block = { "genetics" ~ "{" ~ genetics_instruction* ~ "}" }
lisp_block = { "lisp" ~ "{" ~ (!"}" ~ ANY)* ~ "}" }
brainfuck_block = { "brainfuck" ~ "{" ~ (!"}" ~ ANY)* ~ "}" }
befunge_block = { "befunge" ~ "{" ~ (!"}" ~ ANY)* ~ "}" }
tui_block = { "tui" ~ "{" ~ (!"}" ~ ANY)* ~ "}" }
mosaic_block = { "mosaic" ~ "{" ~ (!"}" ~ ANY)* ~ "}" }
piet_block = { "piet" ~ "{" ~ (!"}" ~ ANY)* ~ "}" }
chaos_block = { "chaos" ~ "{" ~ instruction* ~ "}" }
regex_block = { "regex" ~ "{" ~ (!"}" ~ ANY)* ~ "}" }
acoustic_block = { "acoustic" ~ "{" ~ acoustic_instruction* ~ "}" }
reactor_block = { "reactor" ~ "{" ~ (!"}" ~ ANY)* ~ "}" }
quipu_block = { "quipu" ~ "{" ~ instruction* ~ "}" }
origami_block = { "origami" ~ "{" ~ instruction* ~ "}" }
esolang_block = { "esolang" ~ "{" ~ (!"}" ~ ANY)* ~ "}" }
flocking_block = { "flocking" ~ "{" ~ instruction* ~ "}" }
market_block = { "market" ~ "{" ~ instruction* ~ "}" }

instruction = { string | number | identifier }
hyper_instruction = { (">>" ~ operator ~ "<<") | string | number | identifier }
orca_instruction = { identifier ~ number ~ number }
elektra_instruction = { identifier ~ number ~ number }
prolog_instruction = { identifier ~ "(" ~ identifier ~ ")" ~ "." }
genetics_instruction = { identifier ~ identifier ~ identifier }
acoustic_instruction = { identifier ~ number ~ number? }

operator = { "+" | "-" | "*" | "/" | identifier }
identifier = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ "-"? ~ ASCII_DIGIT+ }
string = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }

poincare_block = { "poincare" ~ "{" ~ instruction* ~ "}" }
weave_block = { "weave" ~ "{" ~ instruction* ~ "}" }
fluid_block = { "fluid" ~ "{" ~ instruction* ~ "}" }
gray_scott_block = { "gray_scott" ~ "{" ~ instruction* ~ "}" }
locus_block = { "locus" ~ "{" ~ instruction* ~ "}" }
neuro_block = { "neuro" ~ "{" ~ instruction* ~ "}" }
platter_block = { "platter" ~ "{" ~ instruction* ~ "}" }

madness_block = { "madness" ~ "{" ~ (!"}" ~ ANY)* ~ "}" }

prologue_esolang_block = { "prologue_esolang" ~ "{" ~ (!"}" ~ ANY)* ~ "}" }

miller_block = { "miller" ~ "{" ~ instruction* ~ "}" }
hyper_block = { "hyper" ~ "{" ~ instruction* ~ "}" }
physics_block = { "physics" ~ "{" ~ instruction* ~ "}" }
ferrous_block = { "ferrous" ~ "{" ~ instruction* ~ "}" }
tardis_block = { "tardis" ~ "{" ~ instruction* ~ "}" }
pachinko_block = { "pachinko" ~ "{" ~ instruction* ~ "}" }
automaton_block = { "automaton" ~ "{" ~ instruction* ~ "}" }
