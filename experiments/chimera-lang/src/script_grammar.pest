WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ ("//" ~ (!"\n" ~ ANY)*) | ("/*" ~ (!"*/" ~ ANY)* ~ "*/") | ("#" ~ (!"\n" ~ ANY)*) }

program = { SOI ~ (include_stmt | macro_def | map_def | strand_def | organelle_def | grammar_def | chimera_def | evolution_def)* ~ EOI }

include_stmt = { "include" ~ string }

macro_def = { "macro" ~ identifier ~ "{" ~ instruction* ~ "}" }

map_def = ${ "map" ~ WHITESPACE+ ~ identifier ~ WHITESPACE* ~ "{" ~ map_content ~ "}" }
map_content = @{ (!"}" ~ ANY)* }

strand_def = { "strand" ~ identifier ~ "{" ~ instruction* ~ "}" }

organelle_def = { "organelle" ~ identifier ~ "{" ~ instruction* ~ "}" }

grammar_def = { "grammar" ~ identifier ~ "{" ~ grammar_content ~ "}" }
grammar_content = { grammar_rule_def* }
grammar_rule_def = { rule_type ~ identifier ~ "{" ~ rule_expr ~ "}" ~ ( "->" ~ transform_block )? }
rule_type = { "rule" | "token" | "regex" }

rule_expr = { rule_choice }
rule_choice = { rule_seq ~ ( "|" ~ rule_seq )* }
rule_seq = { rule_term+ }
rule_term = {
    string |
    regex_literal |
    rule_ref |
    group |
    action_block
}

regex_literal = @{ "/" ~ (!"/" ~ ANY)* ~ "/" }
rule_ref = { identifier }
group = { "(" ~ rule_expr ~ ")" }
action_block = { "{" ~ (!"}" ~ ANY)* ~ "}" }
transform_block = { "{" ~ (!"}" ~ ANY)* ~ "}" }

chimera_def = { "chimera" ~ identifier ~ "{" ~ "grammar" ~ ":" ~ argument ~ "boot" ~ ":" ~ block ~ "}" }

evolution_def = { "evolution" ~ identifier ~ "{" ~ evolution_prop* ~ "}" }
evolution_prop = {
    ( "population" ~ ":" ~ number ) |
    ( "mutation_rate" ~ ":" ~ float ) |
    ( "target" ~ ":" ~ number ) |
    ( "fitness" ~ block ) |
    ( "strategy" ~ block )
}
float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }

instruction = {
    block |
    chaos_block |
    oracle_block |
    polyglot_block |
    literal |
    junction |
    crispr_block |
    apply_map_stmt |
    call |
    arrow_jump |
    question_branch |
    hyper_op |
    cross_op |
    reduce_op |
    zip_op |
    simple_op
}

hyper_op = { ">>" ~ op_symbol ~ "<<" }
cross_op = { "X" ~ op_symbol }
reduce_op = { "[" ~ op_symbol ~ "]" }
zip_op = { "Z" ~ op_symbol }
op_symbol = { "+" | "-" | "*" | "/" | "%" | "&" | "|" | "^" }

apply_map_stmt = { "apply_map" ~ "(" ~ string ~ "," ~ number ~ "," ~ number ~ ")" }

nested_text = @{ ( "{" ~ nested_text ~ "}" | !("{" | "}") ~ ANY )* }
polyglot_block = { "polyglot" ~ identifier ~ "{" ~ nested_text ~ "}" }

chaos_block = { "chaos" ~ block }

oracle_block = { "oracle" ~ "{" ~ oracle_stmt* ~ "}" }
oracle_stmt = { rule_def | fact_def }
fact_def = { "fact" ~ "(" ~ argument_list ~ ")" }
rule_def = { "rule" ~ "(" ~ argument_list ~ ")" ~ ":-" ~ query_expr }
query_expr = { predicate ~ ("," ~ predicate)* }
predicate = { identifier ~ "(" ~ argument_list ~ ")" }

crispr_block = { "crispr" ~ "(" ~ identifier ~ ")" ~ "{" ~ pattern_def ~ instruction* ~ "}" }
pattern_def = { "pattern" ~ ":" ~ identifier ~ ("," ~ identifier)* }

block = { "{" ~ instruction* ~ "}" }

literal = { number | string }
call = { identifier ~ "(" ~ argument_list ~ ")" }

arrow_jump = { "->" ~ identifier }
question_branch = { "?" ~ identifier }

simple_op = { identifier }

argument_list = { argument ~ ("," ~ argument)* }
argument = { literal | junction | data_call | variable | identifier }
variable = @{ "?" ~ (identifier | ASCII_DIGIT+) }

data_call = { identifier ~ "(" ~ argument_list ~ ")" }

junction = { junction_type ~ "(" ~ argument_list ~ ")" }
junction_type = { "any" | "all" }

identifier = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ "-"? ~ ASCII_DIGIT+ }
string = @{ "\"" ~ ( "\\\"" | (!"\"" ~ ANY) )* ~ "\"" }
